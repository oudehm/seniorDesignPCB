# Track only the four editable KiCad projects and their local dependencies.
/*
!/.gitignore
!/README.md
!/brain_PCB/
!/light_PCB/
!/power_PCB/
!/pump_PCB/

# Within project folders, allow only source files and project libraries.
**/*
!*/
!/*_PCB/*.kicad_pro
!/*_PCB/*.kicad_sch
!/*_PCB/*.kicad_pcb
!/*_PCB/*.kicad_dru
!/*_PCB/fp-lib-table
!/*_PCB/sym-lib-table
!/*_PCB/*.kicad_sym
!/*_PCB/symbols/*.kicad_sym
!/*_PCB/*.pretty/*.kicad_mod
!/brain_PCB/3dmodels/USB4110_simplified.wrl
!/.gitignore
!/README.md

# Generated outputs, backups, and machine-specific editor state stay local.
*.kicad_prl
*-backups/
routing/
.history/
