# Whitelist mode: ignore everything, then allow only what each KiCad project needs to open.

*
!*/
!.gitignore

# Core project files
!*.kicad_pro
!*.kicad_sch
!*.kicad_pcb
!*.kicad_prl

# Custom design rules (DRC clearances/widths live here)
!*.kicad_dru

# Project-local libraries and the tables that register them
!fp-lib-table
!sym-lib-table
!*.kicad_sym
!*.pretty/
!*.kicad_mod

# Connector 3D models referenced by brain_PCB footprints
!brain_PCB/3dmodels/*.wrl

# Never track these directories even if they hold whitelisted file types
.history/
routing/
connector_standardization/
.claude/
