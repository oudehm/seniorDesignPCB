		(uuid "1c21613d-fda4-4e4b-ba84-262219d4a067"))
	(text "J1 pinout (matches brain J8 pin-for-pin; straight-through cable):\nJ1.1 GND\nJ1.2 BLUE\nJ1.3 RED\nJ1.4 NIR\nJ1.5 WHITE\nHistorical Nucleo GPIOs: BLUE PE9, NIR PE13, RED PE11, WHITE PB4"
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid "43d0978f-81ef-40e0-ba1f-5514452c292c"))
	(text "GPIO HIGH = ON; 10k gate pull-down = OFF when disconnected.\nJ4 pins 2/4 = RED; pin 3 = NIR. Common ground to controller.\nBlue 0.50 A; red + NIR 0.61 A total; white 0.34 A nominal.\nQ1-Q4: AO3400A, 1=G, 2=S, 3=D. Total load about 1.45 A."
		(exclude_from_sim no)
		(at 147.32 130.81 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid "4b589399-734c-40a8-af82-ece0d5279cca"))
	(text "NIR"
		(exclude_from_sim no)
		(at 60.96 109.22 0)
		(effects
			(font
				(size 1.4 1.4))
			(justify left))
		(uuid "acf9e20c-ab30-45d9-8cd4-bce5731286c0"))
	(text "RED"
		(exclude_from_sim no)
		(at 60.96 71.12 0)
		(effects
			(font
				(size 1.4 1.4))
			(justify left))
		(uuid "df4ab6b7-d1fe-4af8-b41c-57c1ae4d732d"))
