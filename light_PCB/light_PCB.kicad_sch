	(text "12 V INPUT PROTECTION: F1 then Q5 drain; Q5 source feeds +12V.\nD1 cathode to source, anode to gate: 8.2 V gate clamp.\nF1 is replaceable after a fault; verify load/inrush at operating temperature."
		(exclude_from_sim no)
		(at 147.32 222.25 0)
		(effects
			(font
				(size 1 1)))
		(uuid "0d939dc1-929b-4bdc-8cd0-d2b8b22261e5"))
	(text "BLUE"
		(exclude_from_sim no)
		(at 60.96 33.02 0)
		(effects
			(font
				(size 1.4 1.4))
			(justify left))
		(uuid "1ab395b8-026d-42be-85d6-d363f9ed297b"))
	(text "WHITE"
		(exclude_from_sim no)
		(at 60.96 147.32 0)
		(effects
